{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Order (v2)",
  "type": "object",
  "required": ["orderId", "customer", "items", "status", "channel"],
  "additionalProperties": false,
  "properties": {
    "orderId": { "type": "integer", "description": "订单号（新版为数字）" },
    "customer": { "$ref": "#/definitions/Customer" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/Item" },
      "minItems": 1,
      "maxItems": 50
    },
    "status": { "enum": ["paid", "shipped", "cancelled", "refunded"] },
    "channel": { "type": "string", "enum": ["web", "app", "api"] },
    "total": { "type": "number", "minimum": 0.01, "maximum": 1000000 },
    "createdAt": { "type": "string", "format": "date" },
    "memo": { "type": "string", "maxLength": 500 }
  },
  "definitions": {
    "Customer": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "tier": { "enum": ["free", "pro", "enterprise"] },
        "address": { "$ref": "#/definitions/Address" },
        "friends": {
          "type": "array",
          "items": { "$ref": "#/definitions/Customer" },
          "uniqueItems": true
        }
      },
      "required": ["id", "name", "email"]
    },
    "Address": {
      "type": "object",
      "required": ["city", "zip"],
      "properties": {
        "city": { "type": "string" },
        "zip": { "type": "string", "pattern": "^[0-9]{6}(-[0-9]{4})?$" }
      }
    },
    "Item": {
      "type": "object",
      "required": ["sku", "qty", "price"],
      "properties": {
        "sku": { "type": "string" },
        "qty": { "type": "integer", "minimum": 1, "maximum": 9 },
        "price": { "type": "number" },
        "tags": {
          "type": "array",
          "items": [{ "type": "string" }, { "type": "integer" }]
        }
      }
    }
  }
}
